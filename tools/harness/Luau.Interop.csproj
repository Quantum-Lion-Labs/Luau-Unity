<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Luau.Interop</AssemblyName>
    <RootNamespace>Luau.Internal.Interop</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <LuauHostNativeFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">luau_host.dll</LuauHostNativeFileName>
    <LuauHostNativeFileName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libluau_host.so</LuauHostNativeFileName>
    <LuauHostNativePath Condition="'$(LuauHostNativePath)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Luau.Unity\Runtime\Plugins\win-x64\luau_host.dll'))</LuauHostNativePath>
    <LuauHostNativePath Condition="'$(LuauHostNativePath)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\native\luau-host\out\install\linux-x64\libluau_host.so'))</LuauHostNativePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Luau.Unity\Runtime\Interop\AssemblyInfo.cs"
             Link="AssemblyInfo.cs" />
    <Compile Include="..\..\Luau.Unity\Runtime\Interop\NativeTypes.cs"
             Link="NativeTypes.cs" />
    <Compile Include="..\..\Luau.Unity\Runtime\Interop\NativeMethods.cs"
             Link="NativeMethods.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(LuauHostNativePath)"
          Link="$(LuauHostNativeFileName)"
          CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="ValidateLuauHostNativeArtifact" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(LuauHostNativeFileName)' == ''"
           Text="Luau.Interop does not define a native host layout for this operating system. Set LuauHostNativePath and LuauHostNativeFileName explicitly." />
    <Error Condition="!$([System.IO.Path]::IsPathRooted('$(LuauHostNativePath)'))"
           Text="LuauHostNativePath must be an absolute path. Selected value: '$(LuauHostNativePath)'." />
    <Error Condition="!Exists('$(LuauHostNativePath)')"
           Text="The selected luau_host native artifact does not exist: '$(LuauHostNativePath)'." />
    <GetFileHash Files="$(LuauHostNativePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_SelectedLuauHostNativeArtifact" />
    </GetFileHash>
    <Message Importance="High"
             Text="Selected luau_host native artifact: %(_SelectedLuauHostNativeArtifact.FullPath) (SHA256=%(_SelectedLuauHostNativeArtifact.FileHash))" />
  </Target>

</Project>
